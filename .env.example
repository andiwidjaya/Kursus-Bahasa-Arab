# Konfigurasi Supabase
# Salin file ini menjadi .env dan isi nilainya sesuai dengan proyek Supabase Anda.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Whitelist Email Administrator Resmi (Pisahkan dengan koma jika lebih dari satu)
VITE_ADMIN_EMAILS=admin@arabiyyah.com

# Google Gemini API Key untuk RAG AI Tutor Produksi
VITE_GEMINI_API_KEY=your_gemini_api_key_here
